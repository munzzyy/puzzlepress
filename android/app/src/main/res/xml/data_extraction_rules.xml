<?xml version="1.0" encoding="utf-8"?>
<!-- The only state worth keeping is the WebView's own localStorage (streaks
     and per-day completion). It stays off cloud backup so no server ever
     holds a copy, but a direct device-to-device transfer still carries it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer />
</data-extraction-rules>
