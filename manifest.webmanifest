    { "name": "Minigrid", "url": "./games/minigrid/index.html", "icons": [{ "src": "assets/icons/minigrid.svg", "sizes": "any", "type": "image/svg+xml" }] },
    { "name": "Wordweave", "url": "./games/wordweave/index.html", "icons": [{ "src": "assets/icons/wordweave.svg", "sizes": "any", "type": "image/svg+xml" }] },
    { "name": "Edgeways", "url": "./games/edgeways/index.html", "icons": [{ "src": "assets/icons/edgeways.svg", "sizes": "any", "type": "image/svg+xml" }] },
    { "name": "Sudoku", "url": "./games/sudoku/index.html", "icons": [{ "src": "assets/icons/sudoku.svg", "sizes": "any", "type": "image/svg+xml" }] }
